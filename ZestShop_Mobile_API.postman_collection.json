    {
      "name": "📂 Categories",
      "description": "Main categories, sub-categories, and products by category.",
      "item": [
        {
          "name": "Get Main Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/categories/main",
              "host": ["{{base_url}}"],
              "path": ["categories", "main"]
            },
            "description": "Returns all active main categories, each with their sub-categories nested inside."
          }
        },
        {
          "name": "Get All Sub-Categories",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/categories",
              "host": ["{{base_url}}"],
              "path": ["categories"]
            },
            "description": "Returns all active sub-categories with their parent main category info."
          }
        },
        {
          "name": "Get Products by Category",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/categories/1/products?sort=latest&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["categories", "1", "products"],
              "query": [
                { "key": "sort", "value": "latest", "description": "latest | price_asc | price_desc | popular | top_rated" },
                { "key": "per_page", "value": "20", "description": "Max 50" }
              ]
            },
            "description": "Returns paginated products for a given sub-category ID.\n\n**URL params:** Replace `1` with a real category ID.\n\n**Query params:**\n- `sort`: `latest` | `price_asc` | `price_desc` | `popular` | `top_rated`\n- `per_page`: 1–50 (default 20)"
          }
        }
      ]
    },
    {
      "name": "🗂️ Collections",
      "description": "Product collection browsing.",
      "item": [
        {
          "name": "Get All Collections",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/collections",
              "host": ["{{base_url}}"],
              "path": ["collections"]
            },
            "description": "Returns all active product collections."
          }
        },
        {
          "name": "Get Products in Collection",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/collections/summer-sale/products?sort=latest&per_page=20",
              "host": ["{{base_url}}"],
              "path": ["collections", "summer-sale", "products"],
              "query": [
                { "key": "sort", "value": "latest", "description": "latest | price_asc | price_desc | popular | top_rated" },
                { "key": "per_page", "value": "20", "description": "Max 50" }
              ]
            },
            "description": "Returns paginated products within a collection by slug.\n\n**URL params:** Replace `summer-sale` with a real collection slug."
          }
        }
      ]
    },
    {
      "name": "🛍️ Products",
      "description": "Product listing, detail, and search.",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/products?per_page=20&sort=latest",
              "host": ["{{base_url}}"],
              "path": ["products"],
              "query": [
                { "key": "q", "value": "", "description": "Search keyword", "disabled": true },
                { "key": "category_id", "value": "", "description": "Filter by sub-category ID", "disabled": true },
                { "key": "min_price", "value": "", "description": "Minimum price", "disabled": true },
                { "key": "max_price", "value": "", "description": "Maximum price", "disabled": true },
                { "key": "sort", "value": "latest", "description": "latest | price_asc | price_desc | popular | top_rated" },
                { "key": "per_page", "value": "20", "description": "1–50 (default 20)" }
              ]
            },
            "description": "Returns paginated active products.\n\n**Optional query params:**\n- `q` — search by title\n- `category_id` — filter by sub-category\n- `min_price` / `max_price` — price range filter\n- `sort` — `latest` | `price_asc` | `price_desc` | `popular` | `top_rated`\n- `per_page` — 1–50"
          }
        },
        {
          "name": "Search Products",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/products/search?q=nike",
              "host": ["{{base_url}}"],
              "path": ["products", "search"],
              "query": [
                { "key": "q", "value": "nike", "description": "Min 2 characters" }
              ]
            },
            "description": "Live search products by title. Returns up to 10 results.\n\n**Requires** `q` param with minimum 2 characters."
          }
        },
        {
          "name": "Get Product Detail",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/products/nike-air-max",
              "host": ["{{base_url}}"],
              "path": ["products", "nike-air-max"]
            },
            "description": "Returns full product detail including:\n- Color variants with sizes and images\n- Category and main category info\n- Related products (same category)\n\n**URL params:** Replace `nike-air-max` with a real product slug."
          }
        }
      ]
    },
    {
      "name": "❤️ Wishlist",
      "description": "User wishlist management. Requires authentication.",
      "item": [
        {
          "name": "Get Wishlist",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/wishlist",
              "host": ["{{base_url}}"],
              "path": ["wishlist"]
            },
            "description": "Returns all products in the authenticated user's wishlist."
          }
        },
        {
          "name": "Toggle Wishlist (Add / Remove)",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
