            "description": "Add or remove a product from the wishlist.\n\nResponse `status` field will be either `\"added\"` or `\"removed\"`."
          }
        }
      ]
    },
    {
      "name": "🛒 Cart",
      "description": "Shopping cart management. Cart is stored server-side per user (Laravel Cache). Requires authentication.",
      "item": [
        {
          "name": "Get Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/cart",
              "host": ["{{base_url}}"],
              "path": ["cart"]
            },
            "description": "Returns current cart items and order summary (subtotal, service fee, delivery, tax, total)."
          }
        },
        {
          "name": "Add to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var res = pm.response.json();",
                  "if (res.data && res.data.length > 0) {",
                  "    var firstKey = Object.keys(res.data[0])[0];",
                  "    var item = res.data[0];",
                  "    var cartKey = item.id + '_' + item.variant_id + '_' + item.size_id;",
                  "    pm.collectionVariables.set('cart_key', cartKey);",
                  "    console.log('✅ cart_key saved:', cartKey);",
                  "}",
                  "pm.test('Status 200 OK', () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"variant_id\": 1,\n  \"size_id\": 1,\n  \"title\": \"Nike Air Max\",\n  \"price\": 49.99,\n  \"thumbnail\": \"https://via.placeholder.com/100\",\n  \"color_name\": \"Red\",\n  \"size_name\": \"M\",\n  \"qty\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/add",
              "host": ["{{base_url}}"],
              "path": ["cart", "add"]
            },
            "description": "Add an item to the cart. If the same variant+size already exists, quantity is increased.\n\n**Cart key** = `{id}_{variant_id}_{size_id}` — used in increase/decrease/remove requests.\n\n**Auto-saves `cart_key`** for the first item via test script."
          }
        },
        {
          "name": "Increase Qty",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_key\": \"{{cart_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/increase",
              "host": ["{{base_url}}"],
              "path": ["cart", "increase"]
            },
            "description": "Increase the quantity of a cart item by 1.\n\n`cart_key` format: `{product_id}_{variant_id}_{size_id}` e.g. `1_1_1`"
          }
        },
        {
          "name": "Decrease Qty",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_key\": \"{{cart_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/decrease",
              "host": ["{{base_url}}"],
              "path": ["cart", "decrease"]
            },
            "description": "Decrease the quantity of a cart item by 1. Minimum is 1 (will not go below 1)."
          }
        },
        {
          "name": "Remove Item from Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cart_key\": \"{{cart_key}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/cart/remove",
              "host": ["{{base_url}}"],
              "path": ["cart", "remove"]
            },
            "description": "Remove a specific item from the cart entirely."
          }
        },
        {
          "name": "Clear Cart",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "DELETE",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/cart/clear",
              "host": ["{{base_url}}"],
              "path": ["cart", "clear"]
            },
            "description": "Remove all items from the cart and also removes any applied coupon."
          }
        }
      ]
    },
    {
      "name": "🏷️ Coupon",
      "description": "Coupon code management. Requires authentication.",
      "item": [
        {
          "name": "Apply Coupon",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SAVE20\",\n  \"subtotal\": 100.00\n}"
            },
            "url": {
              "raw": "{{base_url}}/coupon/apply",
              "host": ["{{base_url}}"],
              "path": ["coupon", "apply"]
            },
            "description": "Validate and apply a coupon code.\n\n- `code` — the coupon code (case-insensitive)\n- `subtotal` — the current cart subtotal (used to validate `min_order` requirement)\n\nReturns the discount amount and new total."
          }
        },
        {
          "name": "Remove Coupon",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/coupon/remove",
              "host": ["{{base_url}}"],
              "path": ["coupon", "remove"]
            },
            "description": "Remove the currently applied coupon code."
          }
        }
      ]
    },
    {
      "name": "💳 Checkout",
      "description": "Place an order from cart. Requires authentication and non-empty cart.",
      "item": [
        {
          "name": "Checkout",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_name\": \"John Doe\",\n  \"customer_email\": \"john@example.com\",\n  \"customer_phone\": \"012345678\",\n  \"customer_address\": \"123 Street, Phnom Penh, Cambodia\",\n  \"payment_method\": \"ABA\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/checkout",
              "host": ["{{base_url}}"],
              "path": ["checkout"]
            },
            "description": "Place an order from the current cart.\n\n**Prerequisites:** Must have items in cart.\n\n**payment_method** options: `ABA` | `ACLEDA` | `Wing` | `Cash`\n\nOn success:\n- Creates the order in DB\n- Clears the cart\n- Decrements product stock\n- Increments product sales\n- Applies coupon if one was set (and increments coupon used_count)"
          }
        }
      ]
    },
    {
      "name": "📦 Orders",
      "description": "Order history and management. Requires authentication. Users can only see their own orders.",
      "item": [
        {
          "name": "Get Order History",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
            },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/orders?per_page=15",
              "host": ["{{base_url}}"],
              "path": ["orders"],
              "query": [
                { "key": "status", "value": "", "description": "pending | processing | shipped | delivered | cancelled | refund_requested | refunded", "disabled": true },
                { "key": "per_page", "value": "15", "description": "Max 50" }
              ]
            },
